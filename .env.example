# ==============================================================
# ORBITAL ARCHIVE — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure for local or production deployment.
# NEVER commit the real .env file or production credentials to Git.
# ==============================================================

# Application Base URL (e.g. http://localhost:8000 for local dev or https://orbitalarchive.space)
APP_URL=https://your-production-domain.example

# Database Configuration (MySQL 8.0 / PDO)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=orbital_archive
DB_USER=your_database_user
DB_PASS=your_database_password
