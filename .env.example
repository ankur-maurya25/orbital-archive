# Application URL (used for canonical URLs and sitemap generation)
APP_URL=http://localhost:8000

# Database Configuration (MySQL 8.0 / PDO)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=orbital_archive
DB_USER=root
DB_PASS=
